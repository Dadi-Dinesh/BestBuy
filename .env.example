# Application
NODE_ENV=development
APP_PORT=5173

# Database (replace with your actual connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/bestbuy_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bestbuy_db
DATABASE_USER=user
DATABASE_PASSWORD=password

# JWT Secret
JWT_SECRET=your-jwt-secret-key-here

# Data Adapter: "mock" or "postgres"
DATA_ADAPTER=mock
