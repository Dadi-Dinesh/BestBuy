  <diagram id="bestbuy-03" name="03 Database ER Diagram">
    <mxGraphModel page="1" pageWidth="1880" pageHeight="1740" grid="1" gridSize="10" arrows="1" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Database ER Diagram" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1800" height="45" />
        </mxCell>
        <mxCell id="summary" value="Schema bestbuy. PK = primary key, FK = foreign key, UQ = unique. Connectors point parent → child. Composite foreign keys are labeled." style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="68" width="1800" height="52" />
        </mxCell>
        <mxCell id="g0" value="Accounts &amp; geography" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="135" width="405" height="1565" />
        </mxCell>
        <mxCell id="g1" value="Catalogue &amp; stock" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="135" width="405" height="1565" />
        </mxCell>
        <mxCell id="g2" value="Queues &amp; sales" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="965" y="135" width="405" height="1565" />
        </mxCell>
        <mxCell id="g3" value="Test drives &amp; operations" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="135" width="405" height="1565" />
        </mxCell>
        <mxCell id="users" value="&lt;b style=&quot;font-size:15px&quot;&gt;users&lt;/b&gt;&lt;hr&gt;id  uuid  · PK&lt;br&gt;email  text  · UQ&lt;br&gt;password_hash  text&lt;br&gt;name  text&lt;br&gt;phone  text&lt;br&gt;role  text&lt;br&gt;status  text&lt;br&gt;created_at  timestamptz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
          <mxGeometry as="geometry" x="24" y="54" width="355" height="192" />
        </mxCell>
        <mxCell id="customers" value="&lt;b style=&quot;font-size:15px&quot;&gt;customers&lt;/b&gt;&lt;hr&gt;user_id  uuid  · PK, FK" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
          <mxGeometry as="geometry" x="24" y="270" width="355" height="73" />
        </mxCell>
        <mxCell id="dealers" value="&lt;b style=&quot;font-size:15px&quot;&gt;dealers&lt;/b&gt;&lt;hr&gt;id  uuid  · PK&lt;br&gt;user_id  uuid  · FK, UQ&lt;br&gt;name  text&lt;br&gt;registration_number  text&lt;br&gt;status  text&lt;br&gt;profile  jsonb&lt;br&gt;created_at  timestamptz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
          <mxGeometry as="geometry" x="24" y="367" width="355" height="175" />
        </mxCell>
        <mxCell id="cities" value="&lt;b style=&quot;font-size:15px&quot;&gt;cities&lt;/b&gt;&lt;hr&gt;id  uuid  · PK&lt;br&gt;name  text&lt;br&gt;state  text&lt;br&gt;UNIQUE (name,state)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
          <mxGeometry as="geometry" x="24" y="566" width="355" height="124" />
        </mxCell>
        <mxCell id="dealer_locations" value="&lt;b style=&quot;font-size:15px&quot;&gt;dealer_locations&lt;/b&gt;&lt;hr&gt;id  uuid  · PK&lt;br&gt;dealer_id  uuid  · FK&lt;br&gt;city_id  uuid  · FK&lt;br&gt;address  text&lt;br&gt;postal_code  text&lt;br&gt;is_primary  boolean&lt;br&gt;UNIQUE (id,dealer_id)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
          <mxGeometry as="geometry" x="24" y="714" width="355" height="175" />
        </mxCell>
        <mxCell id="password_recovery" value="&lt;b style=&quot;font-size:15px&quot;&gt;password_recovery&lt;/b&gt;&lt;hr&gt;token_hash  text  · PK&lt;br&gt;user_id  uuid  · FK&lt;br&gt;expires_at  timestamptz" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g0">
