        <mxCell id="select" value="Choose dealer listing, date&lt;br&gt;and available IST slot" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l0">
          <mxGeometry as="geometry" x="27" y="56" width="246" height="74" />
        </mxCell>
        <mxCell id="submit" value="Submit contact details&lt;br&gt;and book request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l0">
          <mxGeometry as="geometry" x="27" y="161" width="246" height="74" />
