          <mxGeometry as="geometry" x="27" y="371" width="246" height="74" />
        </mxCell>
        <mxCell id="match" value="Resolve one city via approved&lt;br&gt;INR inventory for the variant" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l1">
