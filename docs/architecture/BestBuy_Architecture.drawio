        <mxCell id="adjust" value="Reschedule to available slot&lt;br&gt;or cancel before start" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l0">
          <mxGeometry as="geometry" x="27" y="266" width="246" height="74" />
        </mxCell>
        <mxCell id="availability" value="Read open future slots&lt;br&gt;within booking window" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l1">
          <mxGeometry as="geometry" x="27" y="56" width="246" height="74" />
        </mxCell>
        <mxCell id="guard" value="Recheck stock, slot and contact&lt;br&gt;inside the write flow" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l1">
          <mxGeometry as="geometry" x="27" y="161" width="246" height="74" />
