  <diagram id="bestbuy-09" name="09 API and Data Flow Architecture">
    <mxGraphModel page="1" pageWidth="1445" pageHeight="720" grid="1" gridSize="10" arrows="1" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="API and Data Flow Architecture" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1365" height="45" />
        </mxCell>
        <mxCell id="summary" value="The desktop API consists of named invoke channels. UI routes are hash routes. There is no standalone HTTP controller layer." style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="68" width="1365" height="52" />
        </mxCell>
        <mxCell id="l0" value="React renderer" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="140" width="300" height="515" />
        </mxCell>
        <mxCell id="l1" value="Electron IPC boundary" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="140" width="300" height="515" />
        </mxCell>
        <mxCell id="l2" value="Application backend" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="140" width="300" height="515" />
        </mxCell>
        <mxCell id="l3" value="Response &amp; data" style="swimlane;html=1;startSize=36;fillColor=#E7E7E7;swimlaneFillColor=#F8F8F8;strokeColor=#A3A3A3;fontColor=#171717;fontSize=15;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="140" width="300" height="515" />
        </mxCell>
        <mxCell id="action" value="User interaction&lt;br&gt;or page data load" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l0">
