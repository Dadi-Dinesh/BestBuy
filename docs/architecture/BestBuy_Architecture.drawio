        </mxCell>
        <mxCell id="summary" value="Requests hold a dealer/day/time slot in IST. PostgreSQL serializes India writes and enforces unique occupancy for active or completed requests." style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="68" width="1020" height="52" />
