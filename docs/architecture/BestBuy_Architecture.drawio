  <diagram id="bestbuy-04" name="04 Authentication and Authorization Flow">
    <mxGraphModel page="1" pageWidth="1100" pageHeight="720" grid="1" gridSize="10" arrows="1" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Authentication and Authorization Flow" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1020" height="45" />
        </mxCell>
        <mxCell id="summary" value="Sessions are tied to Electron webContents. Renderer tokens are state data and are not passed as bearer credentials to IPC." style="text;html=1;align=left;whiteSpace=wrap;fontSize=15;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="68" width="1020" height="52" />
        </mxCell>
