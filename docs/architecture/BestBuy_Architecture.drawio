        </mxCell>
        <mxCell id="outcome" value="Accept → booked&lt;br&gt;Leave → cancelled + expire offers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#484848;fontColor=#171717;fontFamily=Helvetica;fontSize=14;spacing=12;" vertex="1" parent="l1">
